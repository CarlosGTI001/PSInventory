<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PSInventory</title>
    
    <!-- Material Design 3 -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <!-- Material Symbols (iconos MD3 modernos) -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <!-- Material Icons (compatibilidad) -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    
    <!-- Material Web Components CSS -->
    <link rel="stylesheet" href="~/css/material-theme.css" />
    <link rel="stylesheet" href="~/css/md3-select.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        /* Estilos para searchable select */
        .searchable-select-wrapper {
            position: relative;
            display: inline-block;
            width: 100%;
        }
        
        .searchable-select-wrapper .search-button {
            position: absolute;
            right: 8px;
            top: 8px;
            z-index: 10;
        }
        
        .md3-select-field.has-leading-icon.has-search-button {
            padding-right: 48px;
        }
    </style>
    
    <!-- Material Web Components -->
    <script type="importmap">
    {
        "imports": {
            "@@material/web/": "https://esm.run/@@material/web/"
        }
    }
    </script>
    <script type="module">
        import '@@material/web/all.js';
        import {styles as typescaleStyles} from '@@material/web/typography/md-typescale-styles.js';
        document.adoptedStyleSheets.push(typescaleStyles.styleSheet);
    </script>
</head>
<body>
    <div class="app-container">
        <!-- Top App Bar -->
        <header class="app-bar">
            <md-icon-button id="menu-button">
                <md-icon>menu</md-icon>
            </md-icon-button>
            <div class="app-bar-title">
                <span class="md-typescale-title-large">PSInventory</span>
            </div>
            <div class="app-bar-actions">
                <span class="md-typescale-label-medium">
                    @Context.Session.GetString("UserName")
                    @if (!string.IsNullOrEmpty(Context.Session.GetString("UserRole")))
                    {
                        <span class="badge" style="margin-left: 8px;">@Context.Session.GetString("UserRole")</span>
                    }
                </span>
                <md-icon-button href="/Auth/CambiarContrasena" title="Cambiar contraseña">
                    <md-icon>lock_reset</md-icon>
                </md-icon-button>
                <md-icon-button href="/Auth/Logout">
                    <md-icon>logout</md-icon>
                </md-icon-button>
            </div>
        </header>

        <!-- Navigation Drawer -->
        <aside class="navigation-drawer" id="drawer">
            <div class="drawer-header">
                <img src="~/images/logo.png" alt="Logo" style="width: 150px; height: auto; margin-bottom: 8px;" />
                <span class="md-typescale-title-small" style="color: var(--md-sys-color-on-surface-variant);">Sistema de Inventario</span>
            </div>
            
            <nav class="drawer-content">
                @{
                    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? string.Empty;
                    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? string.Empty;
                    var inventarioControllers = new[] { "Categorias", "Articulos", "Compras", "Lotes", "Items" };
                    var ubicacionesControllers = new[] { "Regiones", "Sucursales", "Departamentos" };
                    var operacionesControllers = new[] { "Movimientos", "Despacho", "SalidaSinRegistro", "Solicitudes" };
                    var reportesControllers = new[] { "Reportes" };
                    var infraestructuraControllers = new[] { "Infraestructura" };

                    var inventarioOpen = Array.IndexOf(inventarioControllers, currentController) >= 0;
                    var ubicacionesOpen = Array.IndexOf(ubicacionesControllers, currentController) >= 0;
                    var operacionesOpen = Array.IndexOf(operacionesControllers, currentController) >= 0;
                    var reportesOpen = Array.IndexOf(reportesControllers, currentController) >= 0;
                    var infraestructuraOpen = Array.IndexOf(infraestructuraControllers, currentController) >= 0;
                }

                <a href="/Home/Index" class="nav-item @(currentController == "Home" ? "active" : "")">
                    <md-icon>dashboard</md-icon>
                    <span>Dashboard</span>
                </a>
                
                <div class="nav-section">
                    <span class="nav-section-title md-typescale-label-small">MÓDULOS</span>
                </div>

                <button type="button" class="nav-item nav-parent @(inventarioOpen ? "expanded active" : "")" data-submenu-target="submenu-inventario">
                    <md-icon>inventory_2</md-icon>
                    <span>Inventario</span>
                    <md-icon class="submenu-arrow">expand_more</md-icon>
                </button>
                <div id="submenu-inventario" class="nav-submenu @(inventarioOpen ? "open" : "")">
                    <a href="/Categorias/Index" class="nav-item nav-subitem @(currentController == "Categorias" ? "active" : "")">
                        <md-icon>category</md-icon>
                        <span>Categorías</span>
                    </a>
                    <a href="/Articulos/Index" class="nav-item nav-subitem @(currentController == "Articulos" ? "active" : "")">
                        <md-icon>inventory</md-icon>
                        <span>Artículos</span>
                    </a>
                    <a href="/Compras/Index" class="nav-item nav-subitem @(currentController == "Compras" ? "active" : "")">
                        <md-icon>shopping_cart</md-icon>
                        <span>Compras</span>
                    </a>
                    <a href="/Lotes/Index" class="nav-item nav-subitem @(currentController == "Lotes" ? "active" : "")">
                        <md-icon>sell</md-icon>
                        <span>Lotes</span>
                    </a>
                    <a href="/Items/Index" class="nav-item nav-subitem @(currentController == "Items" ? "active" : "")">
                        <md-icon>inventory_2</md-icon>
                        <span>Items</span>
                    </a>
                </div>

                <button type="button" class="nav-item nav-parent @(ubicacionesOpen ? "expanded active" : "")" data-submenu-target="submenu-ubicaciones">
                    <md-icon>location_on</md-icon>
                    <span>Ubicaciones</span>
                    <md-icon class="submenu-arrow">expand_more</md-icon>
                </button>
                <div id="submenu-ubicaciones" class="nav-submenu @(ubicacionesOpen ? "open" : "")">
                    <a href="/Regiones/Index" class="nav-item nav-subitem @(currentController == "Regiones" ? "active" : "")">
                        <md-icon>public</md-icon>
                        <span>Regiones</span>
                    </a>
                    <a href="/Sucursales/Index" class="nav-item nav-subitem @(currentController == "Sucursales" ? "active" : "")">
                        <md-icon>store</md-icon>
                        <span>Sucursales</span>
                    </a>
                    <a href="/Departamentos/Index" class="nav-item nav-subitem @(currentController == "Departamentos" ? "active" : "")">
                        <md-icon>business_center</md-icon>
                        <span>Departamentos</span>
                    </a>
                </div>

                <button type="button" class="nav-item nav-parent @(operacionesOpen ? "expanded active" : "")" data-submenu-target="submenu-operaciones">
                    <md-icon>swap_horiz</md-icon>
                    <span>Operaciones</span>
                    <md-icon class="submenu-arrow">expand_more</md-icon>
                </button>
                <div id="submenu-operaciones" class="nav-submenu @(operacionesOpen ? "open" : "")">
                    <a href="/Movimientos/Index" class="nav-item nav-subitem @(currentController == "Movimientos" ? "active" : "")">
                        <md-icon>history</md-icon>
                        <span>Historial Movimientos</span>
                    </a>
                    <a href="/Despacho/Index" class="nav-item nav-subitem @(currentController == "Despacho" ? "active" : "")">
                        <md-icon>local_shipping</md-icon>
                        <span>Enviar Artículos</span>
                    </a>
                    <a href="/SalidaSinRegistro/Index" class="nav-item nav-subitem @(currentController == "SalidaSinRegistro" ? "active" : "")">
                        <md-icon>post_add</md-icon>
                        <span>Salida Sin Registro</span>
                    </a>
                    <a href="/Solicitudes/Index" class="nav-item nav-subitem @(currentController == "Solicitudes" ? "active" : "")">
                        <md-icon>request_quote</md-icon>
                        <span>Solicitudes</span>
                    </a>
                </div>

                <button type="button" class="nav-item nav-parent @(reportesOpen ? "expanded active" : "")" data-submenu-target="submenu-reportes">
                    <md-icon>analytics</md-icon>
                    <span>Reportes y Consultas</span>
                    <md-icon class="submenu-arrow">expand_more</md-icon>
                </button>
                <div id="submenu-reportes" class="nav-submenu @(reportesOpen ? "open" : "")">
                    <a href="/Reportes/Index" class="nav-item nav-subitem @(currentController == "Reportes" ? "active" : "")">
                        <md-icon>picture_as_pdf</md-icon>
                        <span>Centro de Reportes PDF</span>
                    </a>
                    <a href="/Movimientos/Index" class="nav-item nav-subitem @(currentController == "Movimientos" ? "active" : "")">
                        <md-icon>table_view</md-icon>
                        <span>Consulta Movimientos</span>
                    </a>
                    <a href="/Sucursales/Index" class="nav-item nav-subitem @(currentController == "Sucursales" ? "active" : "")">
                        <md-icon>table_view</md-icon>
                        <span>Consulta Sucursales</span>
                    </a>
                </div>

                <button type="button" class="nav-item nav-parent @(infraestructuraOpen ? "expanded active" : "")" data-submenu-target="submenu-infraestructura">
                    <md-icon>devices</md-icon>
                    <span>Infraestructura</span>
                    <md-icon class="submenu-arrow">expand_more</md-icon>
                </button>
                <div id="submenu-infraestructura" class="nav-submenu @(infraestructuraOpen ? "open" : "")">
                    <a href="/Infraestructura/Index" class="nav-item nav-subitem @(currentController == "Infraestructura" && currentAction == "Index" ? "active" : "")">
                        <md-icon>dashboard</md-icon>
                        <span>Resumen General</span>
                    </a>
                    <a href="/Infraestructura/Equipos" class="nav-item nav-subitem @(currentController == "Infraestructura" && currentAction == "Equipos" ? "active" : "")">
                        <md-icon>computer</md-icon>
                        <span>Equipos</span>
                    </a>
                    <a href="/Infraestructura/Servicios" class="nav-item nav-subitem @(currentController == "Infraestructura" && currentAction == "Servicios" ? "active" : "")">
                        <md-icon>wifi</md-icon>
                        <span>Servicios</span>
                    </a>
                    <a href="/Infraestructura/Accesorios" class="nav-item nav-subitem @(currentController == "Infraestructura" && currentAction == "Accesorios" ? "active" : "")">
                        <md-icon>camera_alt</md-icon>
                        <span>Accesorios</span>
                    </a>
                    <a href="/Infraestructura/Sucursal" class="nav-item nav-subitem @(currentController == "Infraestructura" && currentAction == "Sucursal" ? "active" : "")">
                        <md-icon>storefront</md-icon>
                        <span>Vista Sucursal</span>
                    </a>
                    <a href="/Infraestructura/Normalizacion" class="nav-item nav-subitem @(currentController == "Infraestructura" && currentAction == "Normalizacion" ? "active" : "")">
                        <md-icon>auto_fix_high</md-icon>
                        <span>Normalización</span>
                    </a>
                    <a href="/Infraestructura/Reportes" class="nav-item nav-subitem @(currentController == "Infraestructura" && currentAction == "Reportes" ? "active" : "")">
                        <md-icon>analytics</md-icon>
                        <span>Reportes Gráficos</span>
                    </a>
                </div>
                
                @if (Context.Session.GetString("UserRole") == "Administrador")
                {
                    <div class="nav-section">
                        <span class="nav-section-title md-typescale-label-small">ADMINISTRACIÓN</span>
                    </div>
                    
                    <a href="/Usuarios/Index" class="nav-item @(currentController == "Usuarios" ? "active" : "")">
                        <md-icon>group</md-icon>
                        <span>Usuarios</span>
                    </a>
                    
                    <a href="/Backup/Index" class="nav-item @(currentController == "Backup" ? "active" : "")">
                        <md-icon>cloud_sync</md-icon>
                        <span>Backup y Migración</span>
                    </a>
                }
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/searchable-select.js" asp-append-version="true"></script>
    <script src="~/js/search-dialog.js" asp-append-version="true"></script>
    <script src="~/js/quick-add-selects.js" asp-append-version="true"></script>
    <script src="~/js/confirmation-dialogs.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Fix md-dialog centering: el <dialog> interno no tiene atributo part,
         solo se puede centrar inyectando CSS en el shadowRoot -->
    <script>
    (function () {
        const DIALOG_CENTER_CSS = `
            dialog {
                position: fixed !important;
                inset: 0 !important;
                margin: auto !important;
                max-height: min(90vh, 100% - 48px) !important;
                max-width: min(90vw, 100% - 48px) !important;
            }
        `;

        function fixMdDialog(el) {
            if (!el || el.tagName !== 'MD-DIALOG') return;
            // Esperar a que el shadow root esté disponible
            if (!el.shadowRoot) {
                requestAnimationFrame(() => fixMdDialog(el));
                return;
            }
            const style = document.createElement('style');
            style.textContent = DIALOG_CENTER_CSS;
            el.shadowRoot.appendChild(style);
        }

        // Fijar elementos existentes cuando el DOM esté listo
        function fixAll() {
            document.querySelectorAll('md-dialog').forEach(fixMdDialog);
        }

        // Observar nuevos md-dialog añadidos dinámicamente
        const observer = new MutationObserver(mutations => {
            mutations.forEach(m => m.addedNodes.forEach(node => {
                if (!node || node.nodeType !== 1) return;
                if (node.tagName === 'MD-DIALOG') fixMdDialog(node);
                node.querySelectorAll && node.querySelectorAll('md-dialog').forEach(fixMdDialog);
            }));
        });

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', fixAll);
        } else {
            fixAll();
        }
        observer.observe(document.documentElement, { childList: true, subtree: true });
    })();
    </script>

    @{
        var validationErrors = ViewData.ModelState.Values
            .SelectMany(v => v.Errors)
            .Select(e => e.ErrorMessage)
            .Where(e => !string.IsNullOrWhiteSpace(e))
            .ToList();
    }
    @if (validationErrors.Any())
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var errors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(validationErrors));
                var dialog = document.createElement('md-dialog');
                dialog.innerHTML = `
                    <div slot="headline" style="display:flex;align-items:center;gap:12px;">
                        <md-icon style="color:var(--md-sys-color-error);font-size:28px;">error</md-icon>
                        <span>Errores de validación</span>
                    </div>
                    <div slot="content" style="min-width:320px;">
                        <ul style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:8px;">
                            ${errors.map(e => `<li style="font-size:14px;line-height:20px;">${e}</li>`).join('')}
                        </ul>
                    </div>
                    <div slot="actions">
                        <md-filled-button id="close-validation-dialog">Entendido</md-filled-button>
                    </div>
                `;
                document.body.appendChild(dialog);
                dialog.show();
                dialog.querySelector('#close-validation-dialog').addEventListener('click', function () {
                    dialog.close();
                    setTimeout(() => dialog.remove(), 300);
                });
            });
        </script>
    }
</body>
</html>
