@model PSInventory.Web.Models.ViewModels.InfraestructuraIndexViewModel

@{
    ViewData["Title"] = "Infraestructura - Equipos";
}

<div style="margin-bottom: 16px; display: flex; align-items: center; gap: 8px; color: var(--md-sys-color-on-surface-variant); font-size: 14px;">
    <md-icon style="font-size: 18px;">home</md-icon>
    <span>Infraestructura</span>
    <md-icon style="font-size: 18px;">chevron_right</md-icon>
    <span style="color: var(--md-sys-color-primary);">Equipos</span>
</div>

<div class="page-header">
    <div>
        <h1 class="md-typescale-display-small" style="margin: 0 0 8px 0;">Equipos de Cómputo</h1>
        <p class="md-typescale-body-large" style="color: var(--md-sys-color-on-surface-variant); margin: 0;">
            Gestión de equipos por zona, sucursal y departamento
        </p>
    </div>
    <div style="display:flex; gap:12px;">
        <md-outlined-button onclick="window.location.href='@Url.Action("ExportarEquiposExcel", new { q = Model.Query, regionId = Model.RegionFiltro, sucursalId = Model.SucursalFiltro, departamentoId = Model.DepartamentoFiltro })'">
            <md-icon slot="icon">table_view</md-icon> Excel
        </md-outlined-button>
        <md-outlined-button onclick="window.location.href='@Url.Action("ExportarEquiposPdf", new { q = Model.Query, regionId = Model.RegionFiltro, sucursalId = Model.SucursalFiltro, departamentoId = Model.DepartamentoFiltro })'">
            <md-icon slot="icon">picture_as_pdf</md-icon> PDF
        </md-outlined-button>
        <md-filled-button onclick="window.location.href='@Url.Action("CreateEquipo")'">
            <md-icon slot="icon">add</md-icon>
            Nuevo Equipo
        </md-filled-button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <md-icon>check_circle</md-icon>
        <span>@TempData["Success"]</span>
    </div>
}

<div class="stats-grid" style="margin-bottom: 24px;">
    <div class="stat-card">
        <div class="stat-card-header">
            <div>
                <div class="stat-card-value">@Model.TotalEquipos</div>
                <div class="stat-card-label">Equipos registrados</div>
            </div>
            <div class="stat-card-icon"><md-icon>computer</md-icon></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <div>
                <div class="stat-card-value" style="color: var(--md-sys-color-success);">@Model.EquiposActivos</div>
                <div class="stat-card-label">Equipos activos</div>
            </div>
            <div class="stat-card-icon" style="background: rgba(76, 175, 80, 0.15);"><md-icon style="color: var(--md-sys-color-success);">check_circle</md-icon></div>
        </div>
    </div>
</div>

<div class="card" style="margin-bottom: 24px;">
    <form method="get" action="@Url.Action("Equipos")" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:12px;">
        <md-filled-text-field name="q" label="Buscar equipo o serial" value="@Model.Query">
            <md-icon slot="leading-icon">search</md-icon>
        </md-filled-text-field>
        <div class="md3-select-field has-leading-icon">
            <md-icon class="md3-select-leading-icon">public</md-icon>
            <select name="regionId" class="md3-select">
                <option value="">Todas las zonas</option>
                @foreach (var region in Model.Regiones)
                {
                    <option value="@region.Value" selected="@(Model.RegionFiltro?.ToString() == region.Value)">@region.Text</option>
                }
            </select>
            <label class="md3-select-label">Zona</label>
        </div>
        <div class="md3-select-field has-leading-icon">
            <md-icon class="md3-select-leading-icon">store</md-icon>
            <select name="sucursalId" class="md3-select">
                <option value="">Todas las sucursales</option>
                @foreach (var sucursal in Model.Sucursales)
                {
                    <option value="@sucursal.Value" selected="@(Model.SucursalFiltro == sucursal.Value)">@sucursal.Text</option>
                }
            </select>
            <label class="md3-select-label">Sucursal</label>
        </div>
        <div class="md3-select-field has-leading-icon">
            <md-icon class="md3-select-leading-icon">business_center</md-icon>
            <select name="departamentoId" class="md3-select">
                <option value="">Todos los departamentos</option>
                @foreach (var dep in Model.Departamentos)
                {
                    <option value="@dep.Value" selected="@(Model.DepartamentoFiltro?.ToString() == dep.Value)">@dep.Text</option>
                }
            </select>
            <label class="md3-select-label">Departamento</label>
        </div>
        <div style="display:flex; gap:8px; align-items:end;">
            <md-filled-button type="submit"><md-icon slot="icon">filter_alt</md-icon>Filtrar</md-filled-button>
            <md-text-button onclick="window.location.href='@Url.Action("Equipos")'; return false;">Limpiar</md-text-button>
        </div>
    </form>
</div>

<div class="card">
    <div class="data-table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Zona / Sucursal</th>
                    <th>Equipo</th>
                    <th>Serial</th>
                    <th>Especificaciones</th>
                    <th>Departamentos</th>
                    <th>Estado</th>
                    <th class="actions-column">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Equipos)
                {
                    <tr>
                        <td>
                            <div>@item.Region</div>
                            <div style="font-size:12px; color:var(--md-sys-color-on-surface-variant);">@item.Sucursal</div>
                        </td>
                        <td><strong>@item.NombreEquipo</strong></td>
                        <td>@item.Serial</td>
                        <td>
                            <div>@item.SistemaOperativo</div>
                            <div style="font-size:12px; color:var(--md-sys-color-on-surface-variant);">@item.Procesador</div>
                            <div style="font-size:12px; color:var(--md-sys-color-on-surface-variant);">@item.Ram</div>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(item.Departamentos) ? "—" : item.Departamentos)</td>
                        <td>
                            @if (item.Activo)
                            {
                                <span class="badge badge-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge">Inactivo</span>
                            }
                        </td>
                        <td class="actions-cell">
                            <md-icon-button onclick="window.location.href='@Url.Action("EditEquipo", new { id = item.Id })'"><md-icon>edit</md-icon></md-icon-button>
                            <md-icon-button onclick="confirmDeleteEquipo(@item.Id)"><md-icon>delete</md-icon></md-icon-button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Equipos.Any())
    {
        <p class="md-typescale-body-medium" style="color:var(--md-sys-color-on-surface-variant); margin:12px 0 0;">No hay equipos registrados.</p>
    }
</div>

@section Scripts {
    <script>
        async function confirmDeleteEquipo(id) {
            if (await showConfirmDialog('Eliminar Equipo', '¿Deseas eliminar este equipo?', 'Eliminar')) {
                const formData = new FormData();
                formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
                const response = await fetch(`@Url.Action("DeleteEquipo")/` + id, { method: 'POST', body: formData });
                const result = await response.json();
                if (result.success) {
                    showSnackbar(result.message, 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showSnackbar(result.message || 'No se pudo eliminar el equipo.', 'error');
                }
            }
        }
    </script>
    @Html.AntiForgeryToken()
}
