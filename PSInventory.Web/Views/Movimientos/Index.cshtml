@model IEnumerable<PSData.Modelos.MovimientoItem>

@{
    ViewData["Title"] = "Historial de Movimientos";
    var totalMovimientos = ViewBag.TotalCount != null ? (int)ViewBag.TotalCount : Model.Count();
    var asignaciones = ViewBag.TotalAsignaciones != null ? (int)ViewBag.TotalAsignaciones : Model.Count(m => m.Motivo == "Asignación Inicial");
    var transferencias = ViewBag.TotalTransferencias != null ? (int)ViewBag.TotalTransferencias : Model.Count(m => m.Motivo == "Transferencia");
    var hoy = ViewBag.TotalHoy != null ? (int)ViewBag.TotalHoy : Model.Count(m => m.FechaMovimiento.Date == DateTime.Today);
    var q = ViewBag.Query as string ?? "";
    var motivo = ViewBag.MotivoFiltro as string ?? "";
    var usuario = ViewBag.UsuarioFiltro as string ?? "";
    var estadoItem = ViewBag.EstadoItemFiltro as string ?? "";
    var currentPage = ViewBag.Page != null ? (int)ViewBag.Page : 1;
    var totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    var pageSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 30;
    var motivos = ViewBag.Motivos as List<string> ?? new List<string>();
    var incluirEliminados = ViewBag.IncluirEliminados != null && (bool)ViewBag.IncluirEliminados;
}

<!-- Breadcrumb -->
<div style="margin-bottom: 16px; display: flex; align-items: center; gap: 8px; color: var(--md-sys-color-on-surface-variant); font-size: 14px;">
    <md-icon style="font-size: 18px;">home</md-icon>
    <span>Inventario</span>
    <md-icon style="font-size: 18px;">chevron_right</md-icon>
    <span style="color: var(--md-sys-color-primary);">Movimientos</span>
</div>

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="md-typescale-display-small" style="margin: 0 0 8px 0;">Historial de Movimientos</h1>
        <p class="md-typescale-body-large" style="color: var(--md-sys-color-on-surface-variant); margin: 0;">
            Registro completo de asignaciones y transferencias de items
        </p>
    </div>
</div>

<!-- Stats Cards -->
<div class="stats-grid" style="margin-bottom: 32px;">
    <div class="stat-card">
        <div class="stat-card-header">
            <div>
                <div class="stat-card-value">@totalMovimientos</div>
                <div class="stat-card-label">Total Movimientos</div>
            </div>
            <div class="stat-card-icon">
                <md-icon>history</md-icon>
            </div>
        </div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div>
                <div class="stat-card-value" style="color: var(--md-sys-color-tertiary);">@asignaciones</div>
                <div class="stat-card-label">Asignaciones</div>
            </div>
            <div class="stat-card-icon" style="background: rgba(149, 117, 205, 0.15);">
                <md-icon style="color: var(--md-sys-color-tertiary);">add_circle</md-icon>
            </div>
        </div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div>
                <div class="stat-card-value" style="color: var(--md-sys-color-secondary);">@transferencias</div>
                <div class="stat-card-label">Transferencias</div>
            </div>
            <div class="stat-card-icon" style="background: rgba(255, 92, 0, 0.15);">
                <md-icon style="color: var(--md-sys-color-secondary);">swap_horiz</md-icon>
            </div>
        </div>
    </div>
    
    <div class="stat-card">
        <div class="stat-card-header">
            <div>
                <div class="stat-card-value" style="color: var(--md-sys-color-success);">@hoy</div>
                <div class="stat-card-label">Hoy</div>
            </div>
            <div class="stat-card-icon" style="background: rgba(76, 175, 80, 0.15);">
                <md-icon style="color: var(--md-sys-color-success);">today</md-icon>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-bottom:16px;">
        <md-icon>check_circle</md-icon>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-error" style="margin-bottom:16px;">
        <md-icon>error</md-icon>
        <span>@TempData["Error"]</span>
    </div>
}

<!-- Filtros -->
<div class="card" style="margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
        <md-icon style="color: var(--md-sys-color-primary);">filter_list</md-icon>
        <h2 class="md-typescale-title-large" style="margin: 0;">Filtros</h2>
    </div>

    <form method="get" action="@Url.Action("Index")">
        <div class="form-row">
            <div class="form-field">
                <div class="md3-select-field has-leading-icon">
                    <md-icon class="md3-select-leading-icon">store</md-icon>
                    <select name="sucursalId" class="md3-select">
                        <option value="">Todas las sucursales</option>
                        @foreach (var sucursal in ViewBag.Sucursales)
                        {
                            <option value="@sucursal.Id" selected="@(ViewBag.SucursalFiltro == sucursal.Id)">@sucursal.Nombre</option>
                        }
                    </select>
                    <label class="md3-select-label">Sucursal</label>
                </div>
                <p class="md3-select-supporting">Filtrar por sucursal origen o destino</p>
            </div>

            <div class="form-field">
                <md-filled-text-field 
                    label="Fecha Inicio" 
                    name="fechaInicio" 
                    type="date"
                    value="@ViewBag.FechaInicio"
                    supporting-text="Fecha inicial del rango">
                    <md-icon slot="leading-icon">event</md-icon>
                </md-filled-text-field>
            </div>

            <div class="form-field">
                <md-filled-text-field 
                    label="Fecha Fin" 
                    name="fechaFin" 
                    type="date"
                    value="@ViewBag.FechaFin"
                    supporting-text="Fecha final del rango">
                    <md-icon slot="leading-icon">event</md-icon>
                </md-filled-text-field>
            </div>
            <div class="form-field">
                <md-filled-text-field
                    label="Buscar"
                    name="q"
                    value="@q"
                    supporting-text="Serial, artículo, motivo u observación">
                    <md-icon slot="leading-icon">search</md-icon>
                </md-filled-text-field>
            </div>
            <div class="form-field">
                <div class="md3-select-field has-leading-icon">
                    <md-icon class="md3-select-leading-icon">swap_horiz</md-icon>
                    <select name="motivo" class="md3-select">
                        <option value="">Todos los motivos</option>
                        @foreach (var itemMotivo in motivos)
                        {
                            <option value="@itemMotivo" selected="@(motivo == itemMotivo)">@itemMotivo</option>
                        }
                    </select>
                    <label class="md3-select-label">Motivo</label>
                </div>
                <p class="md3-select-supporting">Filtra por tipo de movimiento</p>
            </div>
            <div class="form-field">
                <md-filled-text-field
                    label="Usuario responsable"
                    name="usuario"
                    value="@usuario"
                    supporting-text="Nombre de usuario que ejecutó el movimiento">
                    <md-icon slot="leading-icon">person</md-icon>
                </md-filled-text-field>
            </div>
            <div class="form-field">
                <div class="md3-select-field has-leading-icon">
                    <md-icon class="md3-select-leading-icon">inventory_2</md-icon>
                    <select name="estadoItem" class="md3-select">
                        <option value="">Todos los estados</option>
                        <option value="Disponible" selected="@(estadoItem == "Disponible")">Disponible</option>
                        <option value="Asignado" selected="@(estadoItem == "Asignado")">Asignado</option>
                        <option value="En Reparación" selected="@(estadoItem == "En Reparación")">En Reparación</option>
                        <option value="Baja" selected="@(estadoItem == "Baja")">Baja</option>
                    </select>
                    <label class="md3-select-label">Estado del Item</label>
                </div>
                <p class="md3-select-supporting">Estado actual del item relacionado</p>
            </div>
            <div class="form-field">
                <div class="md3-select-field has-leading-icon">
                    <md-icon class="md3-select-leading-icon">format_list_numbered</md-icon>
                    <select name="pageSize" class="md3-select">
                        <option value="10" selected="@(pageSize == 10)">10 por página</option>
                        <option value="30" selected="@(pageSize == 30)">30 por página</option>
                        <option value="50" selected="@(pageSize == 50)">50 por página</option>
                        <option value="100" selected="@(pageSize == 100)">100 por página</option>
                    </select>
                    <label class="md3-select-label">Paginación</label>
                </div>
                <p class="md3-select-supporting">Cantidad de filas por página</p>
            </div>
            <div class="form-field" style="display:flex; align-items:center; gap:10px; padding-top:12px;">
                <input type="checkbox" id="incluirEliminados" name="incluirEliminados" value="true" @(incluirEliminados ? "checked" : "") />
                <label for="incluirEliminados" class="md-typescale-body-medium" style="cursor:pointer;">
                    Incluir envíos anulados lógicamente
                </label>
            </div>
        </div>
        <input type="hidden" name="page" value="1" />

        <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 16px;">
            <md-text-button onclick="window.location.href='@Url.Action("Index")'; return false;">
                <md-icon slot="icon">clear</md-icon>
                Limpiar
            </md-text-button>
            <md-outlined-button type="button" onclick="window.location.href='@Url.Action("ExportarCsv", new { sucursalId = ViewBag.SucursalFiltro, fechaInicio = ViewBag.FechaInicio, fechaFin = ViewBag.FechaFin, motivo, usuario, estadoItem, q, incluirEliminados })'">
                <md-icon slot="icon">download</md-icon>
                Exportar CSV
            </md-outlined-button>
            <md-filled-button type="submit">
                <md-icon slot="icon">search</md-icon>
                Filtrar
            </md-filled-button>
        </div>
    </form>
</div>

<!-- Tabla de Movimientos -->
@if (!Model.Any())
{
    <div class="empty-state">
        <md-icon style="font-size: 64px; color: var(--md-sys-color-outline);">history</md-icon>
        <h3 class="md-typescale-headline-small">No hay movimientos registrados</h3>
        <p class="md-typescale-body-medium">
            @if (!string.IsNullOrEmpty(ViewBag.SucursalFiltro as string)
                || !string.IsNullOrEmpty(ViewBag.FechaInicio as string)
                || !string.IsNullOrEmpty(motivo)
                || !string.IsNullOrEmpty(usuario)
                || !string.IsNullOrEmpty(estadoItem)
                || !string.IsNullOrEmpty(q))
            {
                <text>No se encontraron movimientos con los filtros aplicados.</text>
            }
            else
            {
                <text>Los movimientos de items aparecerán aquí cuando se realicen asignaciones o transferencias.</text>
            }
        </p>
    </div>
}
else
{
    <div class="card">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <md-icon style="color: var(--md-sys-color-primary);">table_chart</md-icon>
                <h3 class="md-typescale-title-medium" style="margin: 0;">Registro de Movimientos</h3>
            </div>
            <span class="md-typescale-body-medium" style="color: var(--md-sys-color-on-surface-variant);">
                @totalMovimientos movimiento@(totalMovimientos != 1 ? "s" : "") registrado@(totalMovimientos != 1 ? "s" : "")
            </span>
        </div>

        <div class="data-table-container">
            <table class="data-table movimientos-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Item</th>
                        <th>Artículo</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th>Motivo</th>
                        <th>Usuario</th>
                        <th>Detalle</th>
                        <th class="actions-column">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movimiento in Model)
                    {
                        var esAnulado = !string.IsNullOrWhiteSpace(movimiento.Observaciones)
                            && movimiento.Observaciones.Contains("[ANULADO_LOGICO]", StringComparison.OrdinalIgnoreCase);
                        var esEnvio = !string.IsNullOrWhiteSpace(movimiento.Motivo)
                            && (movimiento.Motivo.StartsWith("Despacho", StringComparison.OrdinalIgnoreCase)
                                || movimiento.Motivo.StartsWith("Salida Sin Registro", StringComparison.OrdinalIgnoreCase));
                        <tr style="@(esAnulado ? "background: rgba(244,67,54,0.05);" : "")">
                            <td>
                                <div style="display: flex; flex-direction: column;">
                                    <span class="md-typescale-body-medium">@movimiento.FechaMovimiento.ToString("dd/MM/yyyy")</span>
                                    <span class="md-typescale-body-small" style="color: var(--md-sys-color-on-surface-variant);">@movimiento.FechaMovimiento.ToString("HH:mm")</span>
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <md-icon style="color: var(--md-sys-color-primary); font-size: 20px;">qr_code_2</md-icon>
                                    <div style="display: flex; flex-direction: column;">
                                        <strong title="@(movimiento.Item?.Serial ?? $"ID: {movimiento.ItemId}")">@(movimiento.Item?.Serial ?? $"ID: {movimiento.ItemId}")</strong>
                                        <span class="md-typescale-body-small" style="color: var(--md-sys-color-on-surface-variant);">Item ID: @movimiento.ItemId</span>
                                    </div>
                                </div>
                        </td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 2px;">
                                    <strong title="@($"{movimiento.Item?.Articulo?.Marca} {movimiento.Item?.Articulo?.Modelo}")">@movimiento.Item?.Articulo?.Marca @movimiento.Item?.Articulo?.Modelo</strong>
                                    <span class="md-typescale-body-small" style="color: var(--md-sys-color-on-surface-variant);">@movimiento.Item?.Articulo?.Categoria?.Nombre</span>
                                    <span class="md-typescale-body-small" style="color: var(--md-sys-color-on-surface-variant);">Estado: @(movimiento.Item?.Estado ?? "N/A")</span>
                                </div>
                            </td>
                            <td>
                                @if (movimiento.SucursalOrigen != null)
                                {
                                    <span class="badge badge-secondary">@movimiento.SucursalOrigen.Nombre</span>
                                }
                                else
                                {
                                    <span class="badge">Almacén</span>
                                }
                            </td>
                            <td>
                                <span class="badge badge-success">@movimiento.SucursalDestino?.Nombre</span>
                            </td>
                            <td>
                                @if (esAnulado)
                                {
                                    <span class="badge" style="background: rgba(244,67,54,0.15); color: #b71c1c;">
                                        Anulado lógico
                                    </span>
                                }
                                else if (movimiento.Motivo == "Asignación Inicial")
                                {
                                    <span class="badge" style="background: rgba(149, 117, 205, 0.15); color: var(--md-sys-color-tertiary);">
                                        Asignación Inicial
                                    </span>
                                }
                                else if (movimiento.Motivo == "Transferencia")
                                {
                                    <span class="badge badge-warning">Transferencia</span>
                                }
                                else
                                {
                                    <span class="badge">@movimiento.Motivo</span>
                                }
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 2px;">
                                    <span class="md-typescale-body-small" title="@movimiento.UsuarioResponsable"><strong>@movimiento.UsuarioResponsable</strong></span>
                                    @if (!string.IsNullOrWhiteSpace(movimiento.ResponsableRecepcion))
                                    {
                                        <span class="md-typescale-body-small" style="color: var(--md-sys-color-on-surface-variant);" title="@movimiento.ResponsableRecepcion">Recibe: @movimiento.ResponsableRecepcion</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 2px; min-width: 220px;">
                                    <span class="md-typescale-body-small">Cantidad: @movimiento.Cantidad</span>
                                    @if (movimiento.FechaRecepcion.HasValue)
                                    {
                                        <span class="md-typescale-body-small" style="color: var(--md-sys-color-on-surface-variant);">Recepción: @movimiento.FechaRecepcion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(movimiento.Observaciones))
                                    {
                                        <span class="md-typescale-body-small" style="color: var(--md-sys-color-on-surface-variant);" title="@movimiento.Observaciones">@movimiento.Observaciones</span>
                                    }
                                    else
                                    {
                                        <span class="md-typescale-body-small" style="color: var(--md-sys-color-on-surface-variant);">Sin observaciones</span>
                                    }
                                </div>
                            </td>
                            <td class="actions-cell">
                                <a href="@Url.Action("Details", new { id = movimiento.Id })" title="Ver detalle">
                                    <md-icon-button>
                                        <md-icon>visibility</md-icon>
                                    </md-icon-button>
                                </a>
                                @if (!esAnulado)
                                {
                                    <a href="@Url.Action("Edit", new { id = movimiento.Id })" title="Editar salida">
                                        <md-icon-button>
                                            <md-icon>edit</md-icon>
                                        </md-icon-button>
                                    </a>
                                }
                                @if (esEnvio && !esAnulado)
                                {
                                    <md-icon-button title="Anular envío lógicamente" onclick="anularEnvio(@movimiento.Id)">
                                        <md-icon>delete</md-icon>
                                    </md-icon-button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <div style="display:flex; gap:12px; justify-content:flex-end; align-items:center; margin-top:16px;">
                <span class="md-typescale-body-small">Página @currentPage de @totalPages</span>
                <md-outlined-button onclick="window.location.href='@Url.Action("Index", new { sucursalId = ViewBag.SucursalFiltro, fechaInicio = ViewBag.FechaInicio, fechaFin = ViewBag.FechaFin, motivo, usuario, estadoItem, q, incluirEliminados, page = currentPage - 1, pageSize })'" @(currentPage <= 1 ? "disabled" : "")>Anterior</md-outlined-button>
                <md-outlined-button onclick="window.location.href='@Url.Action("Index", new { sucursalId = ViewBag.SucursalFiltro, fechaInicio = ViewBag.FechaInicio, fechaFin = ViewBag.FechaFin, motivo, usuario, estadoItem, q, incluirEliminados, page = currentPage + 1, pageSize })'" @(currentPage >= totalPages ? "disabled" : "")>Siguiente</md-outlined-button>
            </div>
        }
    </div>
}

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        async function anularEnvio(id) {
            const confirmar = confirm('¿Deseas anular lógicamente este envío? El registro no se eliminará físicamente.');
            if (!confirmar) return;

            const motivo = prompt('Motivo de la anulación (opcional):') || '';
            const formData = new FormData();
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
            formData.append('id', id);
            formData.append('motivoAnulacion', motivo);

            try {
                const response = await fetch('@Url.Action("EliminarLogicoEnvio")', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                if (result.success) {
                    if (typeof showSnackbar === 'function') {
                        showSnackbar(result.message, 'success');
                    } else {
                        alert(result.message);
                    }
                    location.reload();
                    return;
                }

                if (typeof showSnackbar === 'function') {
                    showSnackbar(result.message || 'No se pudo anular el envío.', 'error');
                } else {
                    alert(result.message || 'No se pudo anular el envío.');
                }
            } catch (error) {
                if (typeof showSnackbar === 'function') {
                    showSnackbar('Error de conexión al intentar anular el envío.', 'error');
                } else {
                    alert('Error de conexión al intentar anular el envío.');
                }
            }
        }
    </script>
}
