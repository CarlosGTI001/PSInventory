@model PSInventory.Web.Models.ViewModels.InfraEquipoFormViewModel

@{
    ViewData["Title"] = "Nuevo Equipo";
}

<div style="margin-bottom: 16px; display: flex; align-items: center; gap: 8px; color: var(--md-sys-color-on-surface-variant); font-size: 14px;">
    <md-icon style="font-size: 18px;">home</md-icon>
    <span>Módulos</span>
    <md-icon style="font-size: 18px;">chevron_right</md-icon>
    <a href="@Url.Action("Index")" style="color: var(--md-sys-color-on-surface-variant); text-decoration: none;">Infraestructura</a>
    <md-icon style="font-size: 18px;">chevron_right</md-icon>
    <span style="color: var(--md-sys-color-primary);">Nuevo Equipo</span>
</div>

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center;">
    <div>
        <h1 class="md-typescale-display-small" style="margin: 0 0 8px 0;">Registrar Equipo de Cómputo</h1>
        <p class="md-typescale-body-large" style="color: var(--md-sys-color-on-surface-variant); margin: 0;">
            Datos de hardware, sistema, serial y asignación a departamentos
        </p>
    </div>
    <md-filled-tonal-button id="btn-quick-fill">
        <md-icon slot="icon">content_paste</md-icon>
        Pegar Info de Sistema
    </md-filled-tonal-button>
</div>

<!-- Modal para Pegar Información -->
<md-dialog id="dialog-quick-fill">
    <div slot="headline">
        <div style="display:flex; align-items:center; gap:12px;">
            <md-icon style="color:var(--md-sys-color-primary);">content_paste</md-icon>
            <span>Asistente de Autocompletado</span>
        </div>
    </div>
    <div slot="content" style="min-width: 500px; max-width: 800px;">
        <div id="step-paste">
            <p class="md-typescale-body-medium" style="margin-bottom: 16px;">
                Pegue el bloque de texto con la información del equipo para extraer los datos.
            </p>
            <md-filled-text-field
                id="text-info-paste"
                type="textarea"
                rows="10"
                label="Información del sistema"
                placeholder="Ejemplo:&#10;Numero de Serial: 6QMPCV2&#10;Marca: Dell Inc.&#10;Modelo: Wyse 7040..."
                style="width: 100%;">
            </md-filled-text-field>
        </div>

        <div id="step-review" style="display: none;">
            <p class="md-typescale-body-medium" style="margin-bottom: 16px; color: var(--md-sys-color-primary); font-weight: 500;">
                Revise y edite la información extraída antes de cargarla:
            </p>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <md-outlined-text-field id="review-serial" label="Serial"></md-outlined-text-field>
                <md-outlined-text-field id="review-marca" label="Marca"></md-outlined-text-field>
                <md-outlined-text-field id="review-modelo" label="Modelo"></md-outlined-text-field>
                <md-outlined-text-field id="review-procesador" label="Procesador (Detalle)"></md-outlined-text-field>
                <md-outlined-text-field id="review-ram" label="RAM (GB)" type="number"></md-outlined-text-field>
                <md-outlined-text-field id="review-almacenamiento" label="Almacenamiento"></md-outlined-text-field>
                <md-outlined-text-field id="review-tipoRam" label="Tipo RAM (Texto)"></md-outlined-text-field>
                <md-outlined-text-field id="review-os" label="S.O. (Texto)"></md-outlined-text-field>
            </div>
        </div>
    </div>
    <div slot="actions">
        <md-text-button id="btn-cancel-quick-fill">Cancelar</md-text-button>
        <md-filled-button id="btn-extract-data">Extraer Datos</md-filled-button>
        <md-filled-button id="btn-back-to-paste" style="display: none;">Atrás</md-filled-button>
        <md-filled-button id="btn-apply-reviewed-data" style="display: none;">Cargar en Formulario</md-filled-button>
    </div>
</md-dialog>

<form asp-action="CreateEquipo" method="post">
    @Html.AntiForgeryToken()

    <div class="card" style="margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 2px solid var(--md-sys-color-primary);">
            <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(4, 115, 148, 0.15); display: flex; align-items: center; justify-content: center;">
                <md-icon style="color: var(--md-sys-color-primary); font-size: 28px;">computer</md-icon>
            </div>
            <div>
                <h2 class="md-typescale-title-large" style="margin: 0;">Información General</h2>
                <p class="md-typescale-body-small" style="margin: 4px 0 0; color: var(--md-sys-color-on-surface-variant);">Identificación y ubicación del equipo</p>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <md-filled-text-field label="Nombre del equipo *" name="NombreEquipo" required value="@Model.NombreEquipo">
                    <md-icon slot="leading-icon">desktop_windows</md-icon>
                </md-filled-text-field>
                <span asp-validation-for="NombreEquipo" class="field-error"></span>
            </div>
            <div class="form-field">
                <md-filled-text-field label="Código activo" name="CodigoActivo" value="@Model.CodigoActivo">
                    <md-icon slot="leading-icon">badge</md-icon>
                </md-filled-text-field>
                <span asp-validation-for="CodigoActivo" class="field-error"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <div class="md3-select-field has-leading-icon">
                    <md-icon class="md3-select-leading-icon">public</md-icon>
                    <select name="RegionId" id="RegionId" class="md3-select">
                        <option value="">Seleccione una zona</option>
                        @foreach (var region in Model.Regiones)
                        {
                            <option value="@region.Value" selected="@(Model.RegionId?.ToString() == region.Value)">@region.Text</option>
                        }
                    </select>
                    <label class="md3-select-label">Zona</label>
                </div>
                <span asp-validation-for="RegionId" class="field-error"></span>
            </div>
            <div class="form-field">
                <div class="md3-select-field has-leading-icon">
                    <md-icon class="md3-select-leading-icon">store</md-icon>
                    <select name="SucursalId" id="SucursalId" class="md3-select" data-region-source="RegionId" required>
                        <option value="">Seleccione una sucursal</option>
                        @foreach (var sucursal in Model.Sucursales)
                        {
                            <option value="@sucursal.Value" selected="@(Model.SucursalId == sucursal.Value)">@sucursal.Text</option>
                        }
                    </select>
                    <label class="md3-select-label">Sucursal *</label>
                </div>
                <span asp-validation-for="SucursalId" class="field-error"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <md-filled-text-field label="Serial *" name="Serial" required value="@Model.Serial">
                    <md-icon slot="leading-icon">qr_code</md-icon>
                </md-filled-text-field>
                <span asp-validation-for="Serial" class="field-error"></span>
            </div>
        </div>
    </div>

    <div class="card" style="margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 2px solid var(--md-sys-color-secondary);">
            <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(255, 92, 0, 0.15); display: flex; align-items: center; justify-content: center;">
                <md-icon style="color: var(--md-sys-color-secondary); font-size: 28px;">memory</md-icon>
            </div>
            <div>
                <h2 class="md-typescale-title-large" style="margin: 0;">Especificaciones</h2>
                <p class="md-typescale-body-small" style="margin: 4px 0 0; color: var(--md-sys-color-on-surface-variant);">Hardware y sistema operativo</p>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <div class="md3-select-field has-leading-icon">
                    <md-icon class="md3-select-leading-icon">settings_applications</md-icon>
                    <select name="SistemaOperativoId" id="SistemaOperativoId" class="md3-select">
                        <option value="">Seleccione sistema operativo</option>
                        @foreach (var sistema in Model.SistemasOperativos)
                        {
                            <option value="@sistema.Value" selected="@(Model.SistemaOperativoId?.ToString() == sistema.Value)">@sistema.Text</option>
                        }
                    </select>
                    <label class="md3-select-label">Sistema Operativo</label>
                </div>
                <span asp-validation-for="SistemaOperativoId" class="field-error"></span>
            </div>
            <div class="form-field">
                <div class="md3-select-field has-leading-icon">
                    <md-icon class="md3-select-leading-icon">developer_board</md-icon>
                    <select name="TipoProcesadorId" id="TipoProcesadorId" class="md3-select">
                        <option value="">Seleccione procesador</option>
                        @foreach (var proc in Model.TiposProcesador)
                        {
                            <option value="@proc.Value" selected="@(Model.TipoProcesadorId?.ToString() == proc.Value)">@proc.Text</option>
                        }
                    </select>
                    <label class="md3-select-label">Procesador</label>
                </div>
                <span asp-validation-for="TipoProcesadorId" class="field-error"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <md-filled-text-field label="Detalle CPU" name="CpuDetalle" value="@Model.CpuDetalle">
                    <md-icon slot="leading-icon">speed</md-icon>
                </md-filled-text-field>
                <span asp-validation-for="CpuDetalle" class="field-error"></span>
            </div>
            <div class="form-field">
                <div class="md3-select-field has-leading-icon">
                    <md-icon class="md3-select-leading-icon">memory</md-icon>
                    <select name="TipoRamId" id="TipoRamId" class="md3-select">
                        <option value="">Seleccione tipo RAM</option>
                        @foreach (var ram in Model.TiposRam)
                        {
                            <option value="@ram.Value" selected="@(Model.TipoRamId?.ToString() == ram.Value)">@ram.Text</option>
                        }
                    </select>
                    <label class="md3-select-label">Tipo de RAM</label>
                </div>
                <span asp-validation-for="TipoRamId" class="field-error"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <md-filled-text-field label="RAM (GB)" name="RamCantidadGb" type="number" value="@Model.RamCantidadGb">
                    <md-icon slot="leading-icon">numbers</md-icon>
                </md-filled-text-field>
                <span asp-validation-for="RamCantidadGb" class="field-error"></span>
            </div>
            <div class="form-field">
                <md-filled-text-field label="Almacenamiento" name="Almacenamiento" value="@Model.Almacenamiento">
                    <md-icon slot="leading-icon">hard_drive</md-icon>
                </md-filled-text-field>
                <span asp-validation-for="Almacenamiento" class="field-error"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <md-filled-text-field label="Marca" name="Marca" value="@Model.Marca">
                    <md-icon slot="leading-icon">branding_watermark</md-icon>
                </md-filled-text-field>
                <span asp-validation-for="Marca" class="field-error"></span>
            </div>
            <div class="form-field">
                <md-filled-text-field label="Modelo" name="Modelo" value="@Model.Modelo">
                    <md-icon slot="leading-icon">inventory_2</md-icon>
                </md-filled-text-field>
                <span asp-validation-for="Modelo" class="field-error"></span>
            </div>
        </div>
    </div>

    <div class="card" style="margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
            <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(4, 115, 148, 0.15); display: flex; align-items: center; justify-content: center;">
                <md-icon style="color: var(--md-sys-color-primary); font-size: 28px;">groups</md-icon>
            </div>
            <div>
                <h2 class="md-typescale-title-large" style="margin: 0;">Asignación de Departamentos</h2>
                <p class="md-typescale-body-small" style="margin: 4px 0 0; color: var(--md-sys-color-on-surface-variant);">Selecciona los departamentos donde opera este equipo</p>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label class="md3-input-label">Departamentos involucrados</label>
                <div class="checkbox-list-container">
                    @foreach (var dep in Model.Departamentos)
                    {
                        var depId = int.Parse(dep.Value!);
                        var isChecked = Model.DepartamentosSeleccionados.Contains(depId);
                        <label class="checkbox-item @(isChecked ? "selected" : "")">
                            <input type="checkbox" name="DepartamentosSeleccionados" value="@dep.Value" @(isChecked ? "checked" : "") onchange="this.parentElement.classList.toggle('selected', this.checked)" />
                            <span>@dep.Text</span>
                        </label>
                    }
                </div>
                <p class="md3-input-supporting-text">Puedes seleccionar uno o varios departamentos</p>
                <span asp-validation-for="DepartamentosSeleccionados" class="field-error"></span>
            </div>
            <div class="form-field">
                <md-filled-text-field label="Dirección IP" name="DireccionIp" value="@Model.DireccionIp">
                    <md-icon slot="leading-icon">lan</md-icon>
                </md-filled-text-field>
                <span asp-validation-for="DireccionIp" class="field-error"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <md-filled-text-field label="Observaciones" name="Observaciones" type="textarea" rows="4" value="@Model.Observaciones">
                    <md-icon slot="leading-icon">note</md-icon>
                </md-filled-text-field>
                <span asp-validation-for="Observaciones" class="field-error"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-field" style="display:flex; align-items:center; gap:12px;">
                <input type="checkbox" name="Activo" value="true" @(Model.Activo ? "checked" : "") style="width: 20px; height: 20px; cursor: pointer;" />
                <input type="hidden" name="Activo" value="false" />
                <label class="md-typescale-body-large">Equipo activo</label>
            </div>
        </div>
    </div>

    <div class="form-actions" style="background: var(--md-sys-color-surface-container); padding: 24px; border-radius: 16px; box-shadow: var(--md-sys-elevation-level2);">
        <md-text-button onclick="window.location.href='@Url.Action("Index")'; return false;">
            <md-icon slot="icon">cancel</md-icon>
            Cancelar
        </md-text-button>
        <md-filled-button type="submit" style="height: 48px; min-width: 160px;">
            <md-icon slot="icon">save</md-icon>
            Guardar Equipo
        </md-filled-button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        async function cargarSucursalesPorZona(selectedValue = '') {
            const regionSelect = document.getElementById('RegionId');
            const sucursalSelect = document.getElementById('SucursalId');
            if (!regionSelect || !sucursalSelect) return;

            const regionId = regionSelect.value;
            sucursalSelect.innerHTML = '<option value="">Seleccione una sucursal</option>';

            if (!regionId) {
                return;
            }

            try {
                const resp = await fetch(`/Infraestructura/SucursalesPorRegion?regionId=${regionId}`);
                const data = await resp.json();
                data.forEach(s => {
                    const opt = document.createElement('option');
                    opt.value = s.value;
                    opt.textContent = s.text;
                    sucursalSelect.appendChild(opt);
                });

                if (selectedValue) {
                    sucursalSelect.value = selectedValue;
                }
            } catch {
                showSnackbar('No se pudieron cargar las sucursales de la zona seleccionada.', 'error');
            }
        }

        document.addEventListener('DOMContentLoaded', async function () {
            const btnQuickFill = document.getElementById('btn-quick-fill');
            const dialogQuickFill = document.getElementById('dialog-quick-fill');
            const btnExtractData = document.getElementById('btn-extract-data');
            const btnApplyReviewedData = document.getElementById('btn-apply-reviewed-data');
            const btnBackToPaste = document.getElementById('btn-back-to-paste');
            const btnCancelQuickFill = document.getElementById('btn-cancel-quick-fill');
            const textPaste = document.getElementById('text-info-paste');
            
            const stepPaste = document.getElementById('step-paste');
            const stepReview = document.getElementById('step-review');

            if (btnQuickFill && dialogQuickFill) {
                btnQuickFill.addEventListener('click', () => {
                    resetQuickFill();
                    dialogQuickFill.show();
                });
            }

            if (btnCancelQuickFill) {
                btnCancelQuickFill.addEventListener('click', () => dialogQuickFill.close());
            }

            if (btnExtractData && textPaste) {
                btnExtractData.addEventListener('click', () => {
                    const text = textPaste.value;
                    if (!text) {
                        showSnackbar('Por favor pegue información para procesar.', 'error');
                        return;
                    }

                    const data = parseSystemInfo(text);
                    populateReviewFields(data);
                    
                    stepPaste.style.display = 'none';
                    stepReview.style.display = 'block';
                    btnExtractData.style.display = 'none';
                    btnBackToPaste.style.display = 'inline-flex';
                    btnApplyReviewedData.style.display = 'inline-flex';
                });
            }

            if (btnBackToPaste) {
                btnBackToPaste.addEventListener('click', () => {
                    stepPaste.style.display = 'block';
                    stepReview.style.display = 'none';
                    btnExtractData.style.display = 'inline-flex';
                    btnBackToPaste.style.display = 'none';
                    btnApplyReviewedData.style.display = 'none';
                });
            }

            if (btnApplyReviewedData) {
                btnApplyReviewedData.addEventListener('click', () => {
                    const reviewedData = {
                        serial: document.getElementById('review-serial').value,
                        marca: document.getElementById('review-marca').value,
                        modelo: document.getElementById('review-modelo').value,
                        procesador: document.getElementById('review-procesador').value,
                        ram: document.getElementById('review-ram').value,
                        almacenamiento: document.getElementById('review-almacenamiento').value,
                        tipoRam: document.getElementById('review-tipoRam').value,
                        os: document.getElementById('review-os').value
                    };

                    applyToForm(reviewedData);
                    dialogQuickFill.close();
                });
            }

            function resetQuickFill() {
                textPaste.value = '';
                stepPaste.style.display = 'block';
                stepReview.style.display = 'none';
                btnExtractData.style.display = 'inline-flex';
                btnBackToPaste.style.display = 'none';
                btnApplyReviewedData.style.display = 'none';
            }

            function parseSystemInfo(text) {
                const lines = text.split('\n');
                const result = {};
                const mappings = {
                    'serial': [/serial|serie/i, 'Serial'],
                    'marca': [/marca|manufacturer/i, 'Marca'],
                    'modelo': [/modelo|model/i, 'Modelo'],
                    'procesador': [/procesador|processor/i, 'Procesador'],
                    'ram': [/ram total|memoria/i, 'Ram'],
                    'tipoRam': [/tipo ram|memory type/i, 'TipoRam'],
                    'os': [/sistema operativo|os name/i, 'OS'],
                    'almacenamiento': [/almacenamiento|storage|disk/i, 'Almacenamiento']
                };

                lines.forEach(line => {
                    const parts = line.split(':');
                    if (parts.length < 2) return;
                    const key = parts[0].trim().toLowerCase();
                    const value = parts.slice(1).join(':').trim();
                    for (const id in mappings) {
                        if (mappings[id][0].test(key)) result[id] = value;
                    }
                });
                return result;
            }

            function populateReviewFields(data) {
                document.getElementById('review-serial').value = data.serial || '';
                document.getElementById('review-marca').value = data.marca || '';
                document.getElementById('review-modelo').value = data.modelo || '';
                document.getElementById('review-procesador').value = data.procesador || '';
                document.getElementById('review-almacenamiento').value = data.almacenamiento || '';
                document.getElementById('review-tipoRam').value = data.tipoRam || '';
                document.getElementById('review-os').value = data.os || '';

                if (data.ram) {
                    const ramMatch = data.ram.match(/(\d+(\.\d+)?)/);
                    if (ramMatch) {
                        document.getElementById('review-ram').value = Math.round(parseFloat(ramMatch[0]));
                    }
                } else {
                    document.getElementById('review-ram').value = '';
                }
            }

            function applyToForm(data) {
                if (data.serial) document.querySelector('[name="Serial"]').value = data.serial;
                if (data.marca) document.querySelector('[name="Marca"]').value = data.marca;
                if (data.modelo) document.querySelector('[name="Modelo"]').value = data.modelo;
                
                if (data.procesador) {
                    document.querySelector('[name="CpuDetalle"]').value = data.procesador;
                    matchSelect('TipoProcesadorId', data.procesador);
                }

                if (data.ram) {
                    document.querySelector('[name="RamCantidadGb"]').value = data.ram;
                }

                if (data.tipoRam) matchSelect('TipoRamId', data.tipoRam);
                if (data.os) matchSelect('SistemaOperativoId', data.os);
                if (data.almacenamiento) document.querySelector('[name="Almacenamiento"]').value = data.almacenamiento;

                showSnackbar('Información cargada en el formulario correctamente.', 'success');
            }

            function matchSelect(id, text) {
                const select = document.getElementById(id);
                if (!select) return;
                const options = Array.from(select.options);
                const normalizedText = text.toLowerCase().replace(/[^a-z0-9]/g, '');
                const bestMatch = options.find(opt => {
                    if (!opt.value) return false;
                    const optText = opt.textContent.toLowerCase().replace(/[^a-z0-9]/g, '');
                    return normalizedText.includes(optText) || optText.includes(normalizedText);
                });
                if (bestMatch) select.value = bestMatch.value;
            }

            const regionSelect = document.getElementById('RegionId');
            if (regionSelect) {
                regionSelect.addEventListener('change', () => cargarSucursalesPorZona(''));
                if (regionSelect.value) {
                    await cargarSucursalesPorZona('@Model.SucursalId');
                }
            }
        });
    </script>
}
