@model PSInventory.Web.Models.ViewModels.InfraNormalizacionViewModel

@{
    ViewData["Title"] = "Normalización de Datos - Infraestructura";
}

<div style="margin-bottom: 16px; display: flex; align-items: center; gap: 8px; color: var(--md-sys-color-on-surface-variant); font-size: 14px;">
    <md-icon style="font-size: 18px;">home</md-icon>
    <span>Módulos</span>
    <md-icon style="font-size: 18px;">chevron_right</md-icon>
    <a href="@Url.Action("Index")" style="text-decoration: none; color: inherit;">Infraestructura</a>
    <md-icon style="font-size: 18px;">chevron_right</md-icon>
    <span style="color: var(--md-sys-color-primary);">Normalización</span>
</div>

<div class="page-header">
    <div>
        <h1 class="md-typescale-display-small" style="margin: 0 0 8px 0;">Normalización de Datos</h1>
        <p class="md-typescale-body-large" style="color: var(--md-sys-color-on-surface-variant); margin: 0;">
            Estandarice la información de equipos para obtener reportes precisos.
        </p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 24px;">
        <md-icon>check_circle</md-icon>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-error" style="margin-bottom: 24px;">
        <md-icon>error</md-icon>
        <span>@TempData["Error"]</span>
    </div>
}

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px;">
    
    @* Columna Almacenamiento *@
    <div class="column">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
            <md-icon style="color: var(--md-sys-color-primary);">storage</md-icon>
            <h3 class="md-typescale-title-medium" style="margin: 0;">Almacenamiento (Disco)</h3>
        </div>

        @if (!Model.GruposAlmacenamiento.Any())
        {
            <div class="card" style="padding: 24px; text-align: center; background: var(--md-sys-color-surface-container-low);">
                <md-icon style="font-size: 48px; color: var(--md-sys-color-outline-variant); margin-bottom: 12px;">done_all</md-icon>
                <p class="md-typescale-body-medium" style="color: var(--md-sys-color-on-surface-variant);">No se detectaron inconsistencias en almacenamiento.</p>
            </div>
        }
        else
        {
            @foreach (var grupo in Model.GruposAlmacenamiento)
            {
                <div class="card" style="margin-bottom: 16px; border: 1px solid var(--md-sys-color-outline-variant);">
                    <div style="padding: 16px; border-bottom: 1px solid var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container-low); display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span class="md-typescale-label-medium" style="color: var(--md-sys-color-on-surface-variant); text-transform: uppercase;">Patrón detectado</span>
                            <div class="md-typescale-title-small">@grupo.Clave</div>
                        </div>
                        <span class="badge badge-primary">@grupo.Total equipos</span>
                    </div>
                    <div style="padding: 16px;">
                        <p class="md-typescale-body-small" style="margin-bottom: 12px; color: var(--md-sys-color-on-surface-variant);">Variantes encontradas:</p>
                        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px;">
                            @foreach (var v in grupo.Variantes)
                            {
                                <div style="padding: 4px 12px; border-radius: 16px; background: var(--md-sys-color-surface-container-high); border: 1px solid var(--md-sys-color-outline-variant); font-size: 13px;">
                                    <strong>@v.Valor</strong> <span style="color: var(--md-sys-color-on-surface-variant); margin-left: 4px;">(@v.Cantidad)</span>
                                </div>
                            }
                        </div>
                        
                        <form method="post" action="@Url.Action("AplicarNormalizacion")" style="display: flex; gap: 8px; align-items: center;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="campo" value="almacenamiento" />
                            <input type="hidden" name="clave" value="@grupo.Clave" />
                            <md-filled-text-field name="nuevoValor" label="Valor normalizado" value="@grupo.Sugerencia" style="flex: 1;"></md-filled-text-field>
                            <md-filled-button type="submit" style="--md-filled-button-container-shape: 8px;">Aplicar</md-filled-button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>

    @* Columna CPU *@
    <div class="column">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
            <md-icon style="color: var(--md-sys-color-secondary);">memory</md-icon>
            <h3 class="md-typescale-title-medium" style="margin: 0;">Detalle de CPU</h3>
        </div>

        @if (!Model.GruposCpu.Any())
        {
            <div class="card" style="padding: 24px; text-align: center; background: var(--md-sys-color-surface-container-low);">
                <md-icon style="font-size: 48px; color: var(--md-sys-color-outline-variant); margin-bottom: 12px;">done_all</md-icon>
                <p class="md-typescale-body-medium" style="color: var(--md-sys-color-on-surface-variant);">No se detectaron inconsistencias en CPU.</p>
            </div>
        }
        else
        {
            @foreach (var grupo in Model.GruposCpu)
            {
                <div class="card" style="margin-bottom: 16px; border: 1px solid var(--md-sys-color-outline-variant);">
                    <div style="padding: 16px; border-bottom: 1px solid var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container-low); display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span class="md-typescale-label-medium" style="color: var(--md-sys-color-on-surface-variant); text-transform: uppercase;">Patrón detectado</span>
                            <div class="md-typescale-title-small">@grupo.Clave</div>
                        </div>
                        <span class="badge badge-secondary" style="background: var(--md-sys-color-secondary); color: var(--md-sys-color-on-secondary);">@grupo.Total equipos</span>
                    </div>
                    <div style="padding: 16px;">
                        <p class="md-typescale-body-small" style="margin-bottom: 12px; color: var(--md-sys-color-on-surface-variant);">Variantes encontradas:</p>
                        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px;">
                            @foreach (var v in grupo.Variantes)
                            {
                                <div style="padding: 4px 12px; border-radius: 16px; background: var(--md-sys-color-surface-container-high); border: 1px solid var(--md-sys-color-outline-variant); font-size: 13px;">
                                    <strong>@v.Valor</strong> <span style="color: var(--md-sys-color-on-surface-variant); margin-left: 4px;">(@v.Cantidad)</span>
                                </div>
                            }
                        </div>
                        
                        <form method="post" action="@Url.Action("AplicarNormalizacion")" style="display: flex; gap: 8px; align-items: center;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="campo" value="cpu" />
                            <input type="hidden" name="clave" value="@grupo.Clave" />
                            <md-filled-text-field name="nuevoValor" label="Valor normalizado" value="@grupo.Sugerencia" style="flex: 1;"></md-filled-text-field>
                            <md-filled-button type="submit" style="--md-filled-button-container-color: var(--md-sys-color-secondary); --md-filled-button-container-shape: 8px;">Aplicar</md-filled-button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>

    @* Columna Tipo RAM *@
    <div class="column">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
            <md-icon style="color: #6366f1;">settings_input_component</md-icon>
            <h3 class="md-typescale-title-medium" style="margin: 0;">Tipo de RAM</h3>
        </div>

        @if (!Model.GruposTipoRam.Any())
        {
            <div class="card" style="padding: 24px; text-align: center; background: var(--md-sys-color-surface-container-low);">
                <md-icon style="font-size: 48px; color: var(--md-sys-color-outline-variant); margin-bottom: 12px;">done_all</md-icon>
                <p class="md-typescale-body-medium" style="color: var(--md-sys-color-on-surface-variant);">No se detectaron inconsistencias en tipos de RAM.</p>
            </div>
        }
        else
        {
            @foreach (var grupo in Model.GruposTipoRam)
            {
                <div class="card" style="margin-bottom: 16px; border: 1px solid var(--md-sys-color-outline-variant);">
                    <div style="padding: 16px; border-bottom: 1px solid var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container-low); display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span class="md-typescale-label-medium" style="color: var(--md-sys-color-on-surface-variant); text-transform: uppercase;">Patrón detectado</span>
                            <div class="md-typescale-title-small">@grupo.Clave</div>
                        </div>
                        <span class="badge" style="background: #6366f1; color: white;">@grupo.Total equipos</span>
                    </div>
                    <div style="padding: 16px;">
                        <p class="md-typescale-body-small" style="margin-bottom: 12px; color: var(--md-sys-color-on-surface-variant);">Variantes encontradas:</p>
                        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px;">
                            @foreach (var v in grupo.Variantes)
                            {
                                <div style="padding: 4px 12px; border-radius: 16px; background: var(--md-sys-color-surface-container-high); border: 1px solid var(--md-sys-color-outline-variant); font-size: 13px;">
                                    <strong>@v.Valor</strong> <span style="color: var(--md-sys-color-on-surface-variant); margin-left: 4px;">(@v.Cantidad)</span>
                                </div>
                            }
                        </div>
                        
                        <form method="post" action="@Url.Action("AplicarNormalizacion")" style="display: flex; gap: 8px; align-items: center;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="campo" value="tipo-ram" />
                            <input type="hidden" name="clave" value="@grupo.Clave" />
                            <md-filled-text-field name="nuevoValor" label="Valor normalizado" value="@grupo.Sugerencia" style="flex: 1;"></md-filled-text-field>
                            <md-filled-button type="submit" style="--md-filled-button-container-color: #6366f1; --md-filled-button-container-shape: 8px;">Aplicar</md-filled-button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>

    @* Columna Marca *@
    <div class="column">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
            <md-icon style="color: #a855f7;">branding_watermark</md-icon>
            <h3 class="md-typescale-title-medium" style="margin: 0;">Marcas de Equipos</h3>
        </div>

        @if (!Model.GruposMarca.Any())
        {
            <div class="card" style="padding: 24px; text-align: center; background: var(--md-sys-color-surface-container-low);">
                <md-icon style="font-size: 48px; color: var(--md-sys-color-outline-variant); margin-bottom: 12px;">done_all</md-icon>
                <p class="md-typescale-body-medium" style="color: var(--md-sys-color-on-surface-variant);">No se detectaron inconsistencias en marcas.</p>
            </div>
        }
        else
        {
            @foreach (var grupo in Model.GruposMarca)
            {
                <div class="card" style="margin-bottom: 16px; border: 1px solid var(--md-sys-color-outline-variant);">
                    <div style="padding: 16px; border-bottom: 1px solid var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container-low); display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span class="md-typescale-label-medium" style="color: var(--md-sys-color-on-surface-variant); text-transform: uppercase;">Patrón detectado</span>
                            <div class="md-typescale-title-small">@grupo.Clave</div>
                        </div>
                        <span class="badge" style="background: #a855f7; color: white;">@grupo.Total equipos</span>
                    </div>
                    <div style="padding: 16px;">
                        <p class="md-typescale-body-small" style="margin-bottom: 12px; color: var(--md-sys-color-on-surface-variant);">Variantes encontradas:</p>
                        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px;">
                            @foreach (var v in grupo.Variantes)
                            {
                                <div style="padding: 4px 12px; border-radius: 16px; background: var(--md-sys-color-surface-container-high); border: 1px solid var(--md-sys-color-outline-variant); font-size: 13px;">
                                    <strong>@v.Valor</strong> <span style="color: var(--md-sys-color-on-surface-variant); margin-left: 4px;">(@v.Cantidad)</span>
                                </div>
                            }
                        </div>
                        
                        <form method="post" action="@Url.Action("AplicarNormalizacion")" style="display: flex; gap: 8px; align-items: center;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="campo" value="marca" />
                            <input type="hidden" name="clave" value="@grupo.Clave" />
                            <md-filled-text-field name="nuevoValor" label="Valor normalizado" value="@grupo.Sugerencia" style="flex: 1;"></md-filled-text-field>
                            <md-filled-button type="submit" style="--md-filled-button-container-color: #a855f7; --md-filled-button-container-shape: 8px;">Aplicar</md-filled-button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="card" style="background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); border: none;">
    <div style="display:flex; gap:16px; align-items:center;">
        <md-icon style="font-size: 32px;">auto_fix_high</md-icon>
        <div>
            <h4 class="md-typescale-title-small" style="margin: 0 0 4px 0;">¿Cómo funciona la asistencia?</h4>
            <p class="md-typescale-body-medium" style="margin: 0; opacity: 0.9;">
                El sistema identifica valores que tienen el mismo contenido alfanumérico ignorando espacios y símbolos. 
                Al normalizar, <strong>todos los equipos</strong> que coincidan con el patrón se actualizarán con el nuevo valor indicado.
            </p>
        </div>
    </div>
</div>
