@model List<PSInventory.Web.Models.ViewModels.InfraNormalizacionGrupoViewModel>
@{
    var titulo = ViewData["Titulo"] as string;
    var icono = ViewData["Icono"] as string;
    var campoId = ViewData["CampoId"] as string;
    var badgeColor = ViewData["BadgeColor"] as string;
    var token = ViewData["Token"] as string;
}

<div class="column">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
        <md-icon style="color: @badgeColor;">@icono</md-icon>
        <h3 class="md-typescale-title-medium" style="margin: 0;">@titulo</h3>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card" style="padding: 24px; text-align: center; background: var(--md-sys-color-surface-container-low);">
            <md-icon style="font-size: 48px; color: var(--md-sys-color-outline-variant); margin-bottom: 12px;">done_all</md-icon>
            <p class="md-typescale-body-medium" style="color: var(--md-sys-color-on-surface-variant);">No se detectaron inconsistencias.</p>
        </div>
    }
    else
    {
        @foreach (var grupo in Model)
        {
            <div class="card" style="margin-bottom: 16px; border: 1px solid var(--md-sys-color-outline-variant);">
                <div style="padding: 16px; border-bottom: 1px solid var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container-low); display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <span class="md-typescale-label-medium" style="color: var(--md-sys-color-on-surface-variant); text-transform: uppercase;">Patrón detectado</span>
                        <div class="md-typescale-title-small">@grupo.Clave</div>
                    </div>
                    <span class="badge" style="background: @badgeColor; color: white;" title="Registros a unificar">@grupo.Total registros</span>
                </div>
                <div style="padding: 16px;">
                    <p class="md-typescale-body-small" style="margin-bottom: 12px; color: var(--md-sys-color-on-surface-variant);">Variantes encontradas:</p>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px;">
                        @foreach (var v in grupo.Variantes)
                        {
                            <div style="padding: 4px 12px; border-radius: 16px; background: var(--md-sys-color-surface-container-high); border: 1px solid var(--md-sys-color-outline-variant); font-size: 13px;">
                                <strong>@v.Valor</strong>
                            </div>
                        }
                    </div>
                    
                    <form method="post" action="@Url.Action("AplicarNormalizacion")" style="display: flex; gap: 8px; align-items: center;">
                        <input type="hidden" name="campo" value="@campoId" />
                        <input type="hidden" name="clave" value="@grupo.Clave" />
                        <md-filled-text-field name="nuevoValor" label="Valor unificado" value="@grupo.Sugerencia" style="flex: 1;"></md-filled-text-field>
                        <md-filled-button type="submit" style="--md-filled-button-container-color: @badgeColor; --md-filled-button-container-shape: 8px;">Unificar</md-filled-button>
                        <input type="hidden" name="__RequestVerificationToken" value="@token" />
                    </form>
                </div>
            </div>
        }
    }
</div>
