@{
    ViewData["Title"] = "Reportes";
    var categorias = ViewBag.Categorias as List<PSData.Modelos.Categoria> ?? new List<PSData.Modelos.Categoria>();
    var sucursales = ViewBag.Sucursales as List<PSData.Modelos.Sucursal> ?? new List<PSData.Modelos.Sucursal>();
}

<div style="margin-bottom: 16px; display: flex; align-items: center; gap: 8px; color: var(--md-sys-color-on-surface-variant); font-size: 14px;">
    <md-icon style="font-size: 18px;">home</md-icon>
    <span>Inicio</span>
    <md-icon style="font-size: 18px;">chevron_right</md-icon>
    <span style="color: var(--md-sys-color-primary);">Reportes</span>
</div>

<div class="page-header">
    <div>
        <h1 class="md-typescale-display-small" style="margin: 0 0 8px 0;">Centro de Reportes</h1>
        <p class="md-typescale-body-large" style="color: var(--md-sys-color-on-surface-variant); margin: 0;">
            Reportes PDF actualizados al flujo operativo y accesos directos a consultas con tabla y filtros avanzados.
        </p>
    </div>
</div>

<div class="alert alert-info">
    <md-icon>info</md-icon>
    <span>Para análisis en pantalla con paginación y filtros avanzados, usa los módulos de consulta rápida.</span>
</div>

<div class="card" style="margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
        <md-icon style="color: var(--md-sys-color-primary);">table_chart</md-icon>
        <h2 class="md-typescale-title-large" style="margin: 0;">Consultas rápidas en pantalla</h2>
    </div>

    <div class="data-table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Módulo</th>
                    <th>Uso</th>
                    <th class="actions-column">Abrir</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Movimientos</strong></td>
                    <td>Historial con filtros avanzados por fechas, motivo, usuario, estado y sucursal.</td>
                    <td class="actions-cell"><md-filled-button onclick="window.location.href='/Movimientos/Index'">Abrir</md-filled-button></td>
                </tr>
                <tr>
                    <td><strong>Sucursales</strong></td>
                    <td>Tabla con filtros por región, estado, texto libre y paginación configurable.</td>
                    <td class="actions-cell"><md-filled-button onclick="window.location.href='/Sucursales/Index'">Abrir</md-filled-button></td>
                </tr>
                <tr>
                    <td><strong>Regiones</strong></td>
                    <td>Listado de regiones con filtros por estado y paginador.</td>
                    <td class="actions-cell"><md-filled-button onclick="window.location.href='/Regiones/Index'">Abrir</md-filled-button></td>
                </tr>
                <tr>
                    <td><strong>Departamentos</strong></td>
                    <td>Listado con filtros de estado y búsqueda textual.</td>
                    <td class="actions-cell"><md-filled-button onclick="window.location.href='/Departamentos/Index'">Abrir</md-filled-button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px;">
    <div class="card">
        <h3 class="md-typescale-title-medium" style="margin: 0 0 12px 0;">Inventario General (PDF)</h3>
        <div class="form-row">
            <div class="md3-select-field has-leading-icon">
                <md-icon class="md3-select-leading-icon">check_circle</md-icon>
                <select id="ig-estado" class="md3-select">
                    <option value="">Todos</option>
                    <option value="Disponible">Disponible</option>
                    <option value="Asignado">Asignado</option>
                    <option value="En Reparación">En Reparación</option>
                    <option value="Baja">Baja</option>
                </select>
                <label class="md3-select-label">Estado</label>
            </div>
            <div class="md3-select-field has-leading-icon">
                <md-icon class="md3-select-leading-icon">category</md-icon>
                <select id="ig-categoria" class="md3-select">
                    <option value="">Todas las categorías</option>
                    @foreach (var categoria in categorias)
                    {
                        <option value="@categoria.Id">@categoria.Nombre</option>
                    }
                </select>
                <label class="md3-select-label">Categoría</label>
            </div>
            <div class="md3-select-field has-leading-icon">
                <md-icon class="md3-select-leading-icon">store</md-icon>
                <select id="ig-sucursal" class="md3-select">
                    <option value="">Todas las sucursales</option>
                    @foreach (var sucursal in sucursales)
                    {
                        <option value="@sucursal.Id">@sucursal.Nombre</option>
                    }
                </select>
                <label class="md3-select-label">Sucursal</label>
            </div>
        </div>
        <div style="margin-top: 10px;">
            <label style="display:flex; align-items:center; gap:8px; font-size: 14px;">
                <input id="ig-include-costos" type="checkbox" checked />
                Incluir costos y resumen monetario
            </label>
        </div>
        <div style="margin-top: 12px;">
            <md-filled-button onclick="generarInventarioGeneral()">
                <md-icon slot="icon">picture_as_pdf</md-icon>
                Generar PDF
            </md-filled-button>
        </div>
    </div>

    <div class="card">
        <h3 class="md-typescale-title-medium" style="margin: 0 0 12px 0;">Inventario por Sucursal (PDF)</h3>
        <div class="md3-select-field has-leading-icon">
            <md-icon class="md3-select-leading-icon">store</md-icon>
            <select id="ips-sucursal" class="md3-select">
                <option value="">Selecciona sucursal</option>
                @foreach (var sucursal in sucursales)
                {
                    <option value="@sucursal.Id">@sucursal.Nombre</option>
                }
            </select>
            <label class="md3-select-label">Sucursal</label>
        </div>
        <div style="margin-top: 10px;">
            <label style="display:flex; align-items:center; gap:8px; font-size: 14px;">
                <input id="ips-include-costos" type="checkbox" checked />
                Incluir costos y resumen monetario
            </label>
        </div>
        <div style="margin-top: 12px;">
            <md-filled-button onclick="generarInventarioPorSucursal()">
                <md-icon slot="icon">picture_as_pdf</md-icon>
                Generar PDF
            </md-filled-button>
        </div>
    </div>

    <div class="card">
        <h3 class="md-typescale-title-medium" style="margin: 0 0 12px 0;">Movimientos de Items (PDF)</h3>
        <div class="form-row">
            <md-filled-text-field id="mov-fecha-inicio" type="date" label="Fecha inicio"></md-filled-text-field>
            <md-filled-text-field id="mov-fecha-fin" type="date" label="Fecha fin"></md-filled-text-field>
            <div class="md3-select-field has-leading-icon">
                <md-icon class="md3-select-leading-icon">store</md-icon>
                <select id="mov-sucursal" class="md3-select">
                    <option value="">Todas las sucursales</option>
                    @foreach (var sucursal in sucursales)
                    {
                        <option value="@sucursal.Id">@sucursal.Nombre</option>
                    }
                </select>
                <label class="md3-select-label">Sucursal</label>
            </div>
            <div class="md3-select-field has-leading-icon">
                <md-icon class="md3-select-leading-icon">swap_horiz</md-icon>
                <select id="mov-motivo" class="md3-select">
                    <option value="">Todos los motivos</option>
                    <option value="Asignación Inicial">Asignación Inicial</option>
                    <option value="Transferencia">Transferencia</option>
                    <option value="Despacho">Despacho</option>
                    <option value="Despacho - Departamento">Despacho - Departamento</option>
                    <option value="Salida Sin Registro">Salida Sin Registro</option>
                    <option value="Salida Sin Registro - Departamento">Salida Sin Registro - Departamento</option>
                </select>
                <label class="md3-select-label">Motivo</label>
            </div>
            <md-filled-text-field id="mov-usuario" label="Usuario responsable"></md-filled-text-field>
        </div>
        <div style="margin-top: 12px;">
            <md-filled-button onclick="generarMovimientos()">
                <md-icon slot="icon">picture_as_pdf</md-icon>
                Generar PDF
            </md-filled-button>
        </div>
    </div>

    <div class="card">
        <h3 class="md-typescale-title-medium" style="margin: 0 0 12px 0;">Items Garantía por Vencer (PDF)</h3>
        <md-filled-text-field id="garantia-dias" type="number" label="Días de anticipación" value="30"></md-filled-text-field>
        <div style="margin-top: 12px;">
            <md-filled-button onclick="generarGarantias()">
                <md-icon slot="icon">picture_as_pdf</md-icon>
                Generar PDF
            </md-filled-button>
        </div>
    </div>

    <div class="card">
        <h3 class="md-typescale-title-medium" style="margin: 0 0 12px 0;">Reporte de Compras (PDF)</h3>
        <div class="form-row">
            <md-filled-text-field id="compra-fecha-inicio" type="date" label="Fecha inicio"></md-filled-text-field>
            <md-filled-text-field id="compra-fecha-fin" type="date" label="Fecha fin"></md-filled-text-field>
        </div>
        <div style="margin-top: 10px;">
            <label style="display:flex; align-items:center; gap:8px; font-size: 14px;">
                <input id="compra-include-costos" type="checkbox" checked />
                Incluir costos y resumen monetario
            </label>
        </div>
        <div style="margin-top: 12px;">
            <md-filled-button onclick="generarCompras()">
                <md-icon slot="icon">picture_as_pdf</md-icon>
                Generar PDF
            </md-filled-button>
        </div>
    </div>

    <div class="card">
        <h3 class="md-typescale-title-medium" style="margin: 0 0 12px 0;">Estadísticas Generales (PDF)</h3>
        <p class="md-typescale-body-medium" style="color: var(--md-sys-color-on-surface-variant); margin: 0 0 12px 0;">
            Reporte consolidado por estado, categoría, sucursal y valor total del inventario.
        </p>
        <div style="margin: 0 0 10px 0;">
            <label style="display:flex; align-items:center; gap:8px; font-size: 14px;">
                <input id="est-include-costos" type="checkbox" checked />
                Incluir costos y resumen monetario
            </label>
        </div>
        <md-filled-button onclick="generarEstadisticas()">
            <md-icon slot="icon">picture_as_pdf</md-icon>
            Generar PDF
        </md-filled-button>
    </div>
</div>

<script>
    function valueOf(id) {
        return document.getElementById(id)?.value ?? '';
    }

    function checkedOf(id) {
        return document.getElementById(id)?.checked ?? true;
    }

    function buildUrl(base, params) {
        const query = Object.entries(params)
            .filter(([, value]) => value !== null && value !== undefined && value !== '')
            .map(([key, value]) => `${encodeURIComponent(key)}=${encodeURIComponent(value)}`)
            .join('&');

        return query ? `${base}?${query}` : base;
    }

    function generarInventarioGeneral() {
        const url = buildUrl('/Reportes/InventarioGeneral', {
            estado: valueOf('ig-estado'),
            categoriaId: valueOf('ig-categoria'),
            sucursalId: valueOf('ig-sucursal'),
            includeCostos: checkedOf('ig-include-costos')
        });
        window.open(url, '_blank');
    }

    function generarInventarioPorSucursal() {
        const sucursalId = valueOf('ips-sucursal');
        if (!sucursalId) {
            alert('Selecciona una sucursal.');
            return;
        }
        const url = buildUrl('/Reportes/InventarioPorSucursal', {
            sucursalId,
            includeCostos: checkedOf('ips-include-costos')
        });
        window.open(url, '_blank');
    }

    function generarMovimientos() {
        const url = buildUrl('/Reportes/MovimientosItems', {
            fechaInicio: valueOf('mov-fecha-inicio'),
            fechaFin: valueOf('mov-fecha-fin'),
            sucursalId: valueOf('mov-sucursal'),
            motivo: valueOf('mov-motivo'),
            usuario: valueOf('mov-usuario')
        });
        window.open(url, '_blank');
    }

    function generarGarantias() {
        const dias = valueOf('garantia-dias') || '30';
        window.open(`/Reportes/ItemsGarantiaPorVencer?dias=${encodeURIComponent(dias)}`, '_blank');
    }

    function generarCompras() {
        const url = buildUrl('/Reportes/ReporteCompras', {
            fechaInicio: valueOf('compra-fecha-inicio'),
            fechaFin: valueOf('compra-fecha-fin'),
            includeCostos: checkedOf('compra-include-costos')
        });
        window.open(url, '_blank');
    }

    function generarEstadisticas() {
        const url = buildUrl('/Reportes/EstadisticasGenerales', {
            includeCostos: checkedOf('est-include-costos')
        });
        window.open(url, '_blank');
    }
</script>
