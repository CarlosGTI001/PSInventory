@{
    ViewData["Title"] = "Reportes de Infraestructura";
}

<div style="margin-bottom: 16px; display: flex; align-items: center; gap: 8px; color: var(--md-sys-color-on-surface-variant); font-size: 14px;">
    <md-icon style="font-size: 18px;">home</md-icon>
    <span>Módulos</span>
    <md-icon style="font-size: 18px;">chevron_right</md-icon>
    <a href="@Url.Action("Index")" style="text-decoration: none; color: inherit;">Infraestructura</a>
    <md-icon style="font-size: 18px;">chevron_right</md-icon>
    <span style="color: var(--md-sys-color-primary);">Reportes Gráficos</span>
</div>

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center;">
    <div>
        <h1 class="md-typescale-display-small" style="margin: 0 0 8px 0;">Estadísticas de Infraestructura</h1>
        <p class="md-typescale-body-large" style="color: var(--md-sys-color-on-surface-variant); margin: 0;">
            Visualización analítica de los recursos tecnológicos de la empresa.
        </p>
    </div>
    <div style="display: flex; gap: 12px;">
        <md-outlined-button onclick="window.location.href='@Url.Action("ExportarEquiposExcel")'">
            <md-icon slot="icon">table_chart</md-icon> Excel General
        </md-outlined-button>
        <md-filled-tonal-button id="btn-export-grafico" onclick="exportarGraficosPdf()">
            <md-icon slot="icon">auto_awesome</md-icon> Reporte Analítico (AI)
        </md-filled-tonal-button>
        <md-filled-button onclick="window.location.href='@Url.Action("ExportarEquiposPdf", new { layout = "horizontal" })'">
            <md-icon slot="icon">picture_as_pdf</md-icon> PDF Completo
        </md-filled-button>
    </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 24px; margin-top: 24px;">
    
    @* Distribución General *@
    <div class="card" style="padding: 24px;">
        <h3 class="md-typescale-title-medium" style="margin-bottom: 24px; display: flex; align-items: center; gap: 12px;">
            <md-icon style="color: var(--md-sys-color-primary);">pie_chart</md-icon>
            Distribución de Activos
        </h3>
        <div style="height: 300px; display: flex; justify-content: center; align-items: center;">
            <canvas id="chartResumen"></canvas>
        </div>
    </div>

    @* Equipos por Zona *@
    <div class="card" style="padding: 24px;">
        <h3 class="md-typescale-title-medium" style="margin-bottom: 24px; display: flex; align-items: center; gap: 12px;">
            <md-icon style="color: var(--md-sys-color-secondary);">public</md-icon>
            Equipos por Zona
        </h3>
        <div style="height: 300px;">
            <canvas id="chartPorZona"></canvas>
        </div>
    </div>

    @* Equipos por S.O. *@
    <div class="card" style="padding: 24px;">
        <h3 class="md-typescale-title-medium" style="margin-bottom: 24px; display: flex; align-items: center; gap: 12px;">
            <md-icon style="color: var(--md-sys-color-tertiary);">grid_view</md-icon>
            Sistemas Operativos
        </h3>
        <div style="height: 300px;">
            <canvas id="chartPorSO"></canvas>
        </div>
    </div>

    @* Equipos por RAM *@
    <div class="card" style="padding: 24px;">
        <h3 class="md-typescale-title-medium" style="margin-bottom: 24px; display: flex; align-items: center; gap: 12px;">
            <md-icon style="color: #6366f1;">memory</md-icon>
            RAM (Capacidad y Tipo)
        </h3>
        <div style="height: 300px;">
            <canvas id="chartPorRam"></canvas>
        </div>
    </div>

    @* Equipos por Procesador *@
    <div class="card" style="padding: 24px;">
        <h3 class="md-typescale-title-medium" style="margin-bottom: 24px; display: flex; align-items: center; gap: 12px;">
            <md-icon style="color: #a855f7;">developer_board</md-icon>
            Tipos de Procesador
        </h3>
        <div style="height: 300px;">
            <canvas id="chartPorProcesador"></canvas>
        </div>
    </div>

    @* Almacenamiento por Tipo *@
    <div class="card" style="padding: 24px;">
        <h3 class="md-typescale-title-medium" style="margin-bottom: 24px; display: flex; align-items: center; gap: 12px;">
            <md-icon style="color: #f59e0b;">album</md-icon>
            Tecnología de Disco
        </h3>
        <div style="height: 300px;">
            <canvas id="chartPorTipoDisco"></canvas>
        </div>
    </div>

    @* Almacenamiento por Capacidad *@
    <div class="card" style="padding: 24px;">
        <h3 class="md-typescale-title-medium" style="margin-bottom: 24px; display: flex; align-items: center; gap: 12px;">
            <md-icon style="color: #ff5c00;">sd_storage</md-icon>
            Capacidad de Almacenamiento
        </h3>
        <div style="height: 300px;">
            <canvas id="chartPorCapacidadDisco"></canvas>
        </div>
    </div>

    @* Equipos por Almacenamiento (Original) *@
    <div class="card" style="padding: 24px;">
        <h3 class="md-typescale-title-medium" style="margin-bottom: 24px; display: flex; align-items: center; gap: 12px;">
            <md-icon style="color: #64748b;">inventory_2</md-icon>
            Detalle de Almacenamiento
        </h3>
        <div style="height: 300px;">
            <canvas id="chartPorAlmacenamiento"></canvas>
        </div>
    </div>

    @* Servicios por Tipo *@
    <div class="card" style="padding: 24px;">
        <h3 class="md-typescale-title-medium" style="margin-bottom: 24px; display: flex; align-items: center; gap: 12px;">
            <md-icon style="color: #ff5c00;">router</md-icon>
            Servicios de Sucursal
        </h3>
        <div style="height: 300px;">
            <canvas id="chartPorTipoServicio"></canvas>
        </div>
    </div>

    @* Accesorios *@
    <div class="card" style="padding: 24px;">
        <h3 class="md-typescale-title-medium" style="margin-bottom: 24px; display: flex; align-items: center; gap: 12px;">
            <md-icon style="color: var(--md-sys-color-success);">headphones</md-icon>
            Tipos de Accesorios
        </h3>
        <div style="height: 300px;">
            <canvas id="chartPorTipoAccesorio"></canvas>
        </div>
    </div>
</div>

<div class="card" style="margin-top: 24px; background: var(--md-sys-color-surface-container-low);">
    <div style="display:flex; justify-content: space-between; align-items: center;">
        <div>
            <h4 class="md-typescale-title-small" style="margin: 0 0 4px 0;">Exportación de Datos Crudos</h4>
            <p class="md-typescale-body-medium" style="color: var(--md-sys-color-on-surface-variant); margin: 0;">Obtenga listados completos en formato CSV para análisis externo.</p>
        </div>
        <div style="display:flex; gap: 12px;">
            <md-text-button href="@Url.Action("ExportarEquiposCsv")"><md-icon slot="icon">file_download</md-icon> Equipos (CSV)</md-text-button>
            <md-text-button href="@Url.Action("ExportarServiciosCsv")"><md-icon slot="icon">file_download</md-icon> Servicios (CSV)</md-text-button>
            <md-text-button href="@Url.Action("ExportarAccesoriosCsv")"><md-icon slot="icon">file_download</md-icon> Accesorios (CSV)</md-text-button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            initChart('chartResumen', '@Url.Action("GetInfraestructuraResumen")', 'pie');
            initChart('chartPorZona', '@Url.Action("GetEquiposPorZona")', 'bar', true);
            initChart('chartPorSO', '@Url.Action("GetEquiposPorSistemaOperativo")', 'bar', true);
            initChart('chartPorRam', '@Url.Action("GetEquiposPorRam")', 'bar', true);
            initChart('chartPorProcesador', '@Url.Action("GetEquiposPorProcesador")', 'bar', true);
            initChart('chartPorTipoDisco', '@Url.Action("GetEquiposPorTipoDisco")', 'bar', true);
            initChart('chartPorCapacidadDisco', '@Url.Action("GetEquiposPorCapacidadDisco")', 'bar', true);
            initChart('chartPorAlmacenamiento', '@Url.Action("GetEquiposPorAlmacenamiento")', 'bar', true);
            initChart('chartPorTipoServicio', '@Url.Action("GetServiciosPorTipo")', 'bar', true);
            initChart('chartPorTipoAccesorio', '@Url.Action("GetAccesoriosPorTipo")', 'bar', true);
        });

        async function initChart(canvasId, url, type, horizontal = false) {
            try {
                const response = await fetch(url);
                const data = await response.json();
                
                const ctx = document.getElementById(canvasId).getContext('2d');
                
                const config = {
                    type: type,
                    data: data,
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: {
                            onComplete: function() {
                                // Marcamos que el gráfico está listo para ser capturado si es necesario
                                document.getElementById(canvasId).dataset.ready = "true";
                            }
                        },
                        plugins: {
                            legend: {
                                display: type === 'pie',
                                position: 'bottom'
                            }
                        }
                    }
                };

                if (type === 'bar') {
                    config.options.indexAxis = horizontal ? 'y' : 'x';
                    config.options.scales = {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true }
                    };
                    
                    if (horizontal) {
                        config.options.scales.x = { beginAtZero: true };
                        config.options.scales.y = { grid: { display: false } };
                    }
                }

                new Chart(ctx, config);
            } catch (error) {
                console.error('Error cargando gráfico ' + canvasId, error);
            }
        }

        async function exportarGraficosPdf() {
            LoadingHelper.show('Generando análisis con IA y preparando PDF...');
            
            try {
                const charts = [
                    { id: 'chartResumen', titulo: 'Distribución de Activos' },
                    { id: 'chartPorZona', titulo: 'Equipos por Zona' },
                    { id: 'chartPorSO', titulo: 'Sistemas Operativos' },
                    { id: 'chartPorRam', titulo: 'Capacidad de RAM' },
                    { id: 'chartPorProcesador', titulo: 'Tipos de Procesador' },
                    { id: 'chartPorTipoDisco', titulo: 'Tecnología de Disco' },
                    { id: 'chartPorCapacidadDisco', titulo: 'Capacidad de Almacenamiento' }
                ];

                const exportData = {
                    graficos: []
                };

                for (const chartInfo of charts) {
                    const canvas = document.getElementById(chartInfo.id);
                    if (canvas) {
                        // Capturamos la imagen en alta resolución (usando el canvas actual)
                        const base64 = canvas.toDataURL('image/png', 1.0);
                        exportData.graficos.push({
                            titulo: chartInfo.titulo,
                            base64Image: base64
                        });
                    }
                }

                const response = await fetch('@Url.Action("ExportarReporteGrafico")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    },
                    body: JsonSerializer.serialize(exportData) // Usamos el helper global si existe o JSON.stringify
                });

                // Si JsonSerializer no está definido en el layout, usamos JSON.stringify
                const finalResponse = await fetch('@Url.Action("ExportarReporteGrafico")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    },
                    body: JSON.stringify(exportData)
                });

                const result = await finalResponse.json();

                if (result.success) {
                    const link = document.createElement('a');
                    link.href = 'data:application/pdf;base64,' + result.fileBase64;
                    link.download = result.fileName;
                    link.click();
                    showSnackbar('Reporte generado exitosamente con análisis de IA.', 'success');
                } else {
                    showSnackbar('Error al generar el reporte.', 'error');
                }
            } catch (error) {
                console.error('Error al exportar reporte gráfico:', error);
                showSnackbar('Error crítico al procesar el reporte.', 'error');
            } finally {
                LoadingHelper.hide();
            }
        }
    </script>
}
